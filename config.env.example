# Copy to config.env (Install-VpnMonitor.ps1 does it on first run), then fill in.
# Environment variables with the same name take precedence over this file.

# Targets: ip:port separated by commas (port 443 by default). To monitor a new IP, just add it here
# (Zabbix discovers it automatically).
VPN_TARGETS=192.0.2.10:443,198.51.100.20:443

# HTTP proxy used to reach the Internet (host:port, CONNECT method, no authentication).
# Empty = direct connection.
PROXY=proxy.example.internal:3128

# --- Reporting: enable one, the other, or both ---
ZABBIX_ENABLED=true
MAIL_ENABLED=false

# --- Zabbix ---
# JSON file read by the Zabbix agent (must match the {$UAG.VPN.FILE} template macro).
# Default: state\zabbix.json next to the script.
# ZABBIX_FILE=C:\VpnMonitor\state\zabbix.json

# --- E-mails (if MAIL_ENABLED=true) ---
ALERT_EMAIL_TO=ops@example.com
# ALERT_EMAIL_FROM=vpn-monitor@example.com   # default: SMTP_USER
# REMINDER_MINUTES=60                        # reminder while the outage lasts
# Option 1: internal SMTP relay without authentication (recommended, no password stored)
#   SMTP_HOST=smtp.example.internal
#   SMTP_PORT=25
#   SMTP_USE_TLS=false
# Option 2: Gmail (app password, 2FA required) - port 587 STARTTLS (465 not supported)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your.account@gmail.com
SMTP_PASSWORD=

# --- Optional ---
# TLS_SNI=tunnel.example.com       # name sent in the TLS handshake if the UAG requires it
# TLS_PROTOCOLS=Tls12, Tls13       # default: TLS 1.3 preferred, TLS 1.2 fallback; "Tls13" = TLS 1.3 only
# TIMEOUT=10                       # seconds per attempt
# RETRIES=3
# RETRY_DELAY=10
# CERT_WARN_DAYS=14                # e-mail threshold (Zabbix side: {$UAG.VPN.CERT.WARN} macro)
# LOG_RETENTION_MONTHS=6
